  m_Script: {fileID: 11500000, guid: ec1556faa70b3ce43862d54865c7f42e, type: 3}
  m_Name: SkullMonkIntro
  m_EditorClassIdentifier: Assembly-CSharp::EasternFantasy.Dialogue.DialogueSequence
  playerCharacter: {fileID: 11400000, guid: 2758d9b9772cd2441bb27040af28cb98, type: 2}
  partnerCharacter: {fileID: 11400000, guid: 0abbbb2c85491304295d70be8d41bfe2, type: 2}
  lines:
  - speaker: 0
    text: "\uC774 \uC808\uC758 \uAE30\uC6B4\u2026 \uB2F9\uC2E0\uC5D0\uAC8C\uC11C
      \uD758\uB7EC\uB098\uC624\uB294 \uAC74\uAC00?"
    classOverrides: []
    firstAdvancementText: 
  - speaker: 1
    text: "\uC624\uB79C \uCE68\uBB35\uC744 \uAE68\uC6B0\uB294 \uBC1C\uC18C\uB9AC\uB85C\uAD6C\uB098.
      \uC774\uACF3\uC5D0\uB294 \uC5B4\uCC0C \uC654\uB290\uB0D0."
    classOverrides: []
    firstAdvancementText: 
  - speaker: 0
    text: "\uC0AC\uB78C\uB4E4\uC744 \uD574\uCE58\uB294 \uC6D0\uC778\uC744 \uCC3E\uC73C\uB7EC
      \uC654\uB2E4. \uAE38\uC744 \uC5F4\uC5B4\uB77C."
    classOverrides: []
    firstAdvancementText: 
  - speaker: 1
    text: "\uC544\uC9C1\uB3C4 \uC774 \uBB38 \uB108\uBA38\uB97C \uC6D0\uD558\uB290\uB0D0.
      \uADF8\uB807\uB2E4\uBA74 \uB124 \uB73B\uC744 \uC99D\uBA85\uD574 \uBCF4\uC544\uB77C."
    classOverrides: []
    firstAdvancementText: 
  completionExperience: 0
