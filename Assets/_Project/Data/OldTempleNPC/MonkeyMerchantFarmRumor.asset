  playerCharacter: {fileID: 11400000, guid: 2758d9b9772cd2441bb27040af28cb98, type: 2}
  partnerCharacter: {fileID: 11400000, guid: 473aeae6a19d18549ad4a7de9b59a0b7, type: 2}
  lines:
  - speaker: 1
    text: "\uD5C8\uD5C8, \uBA3C \uAE38\uC744 \uC654\uAD6C\uBA3C. \uD544\uC694\uD55C
      \uBB3C\uAC74\uC774 \uC788\uC73C\uBA74 \uC0B4\uD3B4\uBCF4\uAC8C. \uC790\uB124
      \uBB3C\uAC74\uB3C4 \uC0AC \uC8FC\uC9C0."
    classOverrides: []
    firstAdvancementText: 
  - speaker: 1
    text: "\uae68\uc9c4 \ubd09\uc778 \ucabd\uc5d0 \ud2c8\uc774 \ubc8c\uc5b4\uc84c\ub2e4\uc9c0? \uac70\uae30\uc11c \ub18d\uc7a5\uc5d0 \ub2e4\ub140\uc628 \uc190\ub2d8\uc774 \uadf8\ub7ec\ub354\uad70. \uac70\uc778\uc774 \ubc18\uc9dd\uc774\ub294 \ub3cc\uc744 \uc8fc\uc6cc \uac14\ub2e4\uace0."
    classOverrides: []
    firstAdvancementText:
  completionExperience: 0
