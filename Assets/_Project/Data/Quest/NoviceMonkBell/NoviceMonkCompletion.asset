  - speaker: 1
    text: "\ud568\uaed8 \uc640 \uc8fc\uc154\uc11c \uace0\ub9c8\uc6cc\uc694. \uc774\uc81c \uc885\uc744 \uc6b8\ub9ac\uba74 \uadf8 \uc18c\ub9ac\uac00 \ub3d9\uad74 \uae4a\uc740 \uacf3\uae4c\uc9c0 \ud37c\uc9c8 \uac70\uc608\uc694."
