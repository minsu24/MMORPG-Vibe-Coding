  lines:
  - speaker: 1
    text: "\uC774\uBC88\uC5D4 \uC0AC\uCC30 \uC678\uACFD\uC5D0 \uC778\uBA74\uC870\uAC00
      \uC788\uB294\uB370 \uB9D0\uC77C\uC138. \uC778\uBA74\uC870 \uC5F4\uB450 \uB9C8\uB9AC\uB97C
      \uCC98\uCE58\uD558\uACE0 \uAE43\uD138 \uC5F4\uB450 \uAC1C\uB97C \uAC00\uC838\uB2E4\uC8FC\uACA0\uB098?"
    classOverrides: []
    firstAdvancementText: 
  - speaker: 0
    text: "\uD544\uC694\uD55C \uAC83\uB3C4 \uCC38 \uB9CE\uAD6C\uB098.  "
    classOverrides:
    - characterClass: 1
      text: "\uD544\uC694\uD55C\uAC8C \uB9CE\uC73C\uC2E0\uAC00 \uBCF4\uC624"
    - characterClass: 2
      text: "\uD544\uC694\uD55C\uAC8C \uB9CE\uC73C\uC2DC\uB124\uC694"
