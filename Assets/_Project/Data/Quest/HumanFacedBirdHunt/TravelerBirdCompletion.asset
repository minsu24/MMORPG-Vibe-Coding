  playerCharacter: {fileID: 0}
  partnerCharacter: {fileID: 11400000, guid: 4813f7681cdd4374d911c43214df06ce, type: 2}
  lines:
  - speaker: 1
    text: "\uC5F4\uB450 \uB9C8\uB9AC\uB97C \uCC98\uCE58\uD558\uACE0 \uAE43\uD138\uB3C4
      \uC5F4\uB450 \uAC1C \uBAA8\uC544 \uC654\uAD70. \uB355\uBD84\uC5D0 \uC774 \uAE38\uC744
      \uD55C\uACB0 \uC548\uC2EC\uD558\uACE0 \uB2E4\uB2D0 \uC218 \uC788\uACA0\uB124."
    classOverrides: []
    firstAdvancementText: 
  - speaker: 1
    text: "\uc778\uba74\uc870\uc758 \uae43\ud138\uc5d0\ub294 \uc2e0\ube44\ud55c \ud798\uc774 \uae43\ub4e4\uc5b4 \uc788\ub124. \ubab8\uc5d0 \uc9c0\ub2c8\uba74 \ud769\uc5b4\uc9c4 \uae30\uc6b4\uc774 \uc870\uae08\uc529 \ub3cc\uc544\uc624\uc9c0."
    classOverrides: []
    firstAdvancementText:
  - speaker: 1
    text: "\uc608\uc804\uc5d0 \uadf8 \uae43\ud138\uc744 \uc5ee\uc5b4 \ub9cc\ub4e0 \ubc18\uc9c0\uac00 \ud558\ub098 \uc788\ub124. \uc774 \uae38\uc744 \uc548\uc804\ud558\uac8c \ud574 \uc900 \ub2f5\ub840\ub85c \uc790\ub124\uc5d0\uac8c \uc8fc\uaca0\ub124."
    classOverrides: []
    firstAdvancementText:
  completionExperience: 0
