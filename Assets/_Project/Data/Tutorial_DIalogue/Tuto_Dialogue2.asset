  m_Script: {fileID: 11500000, guid: ec1556faa70b3ce43862d54865c7f42e, type: 3}
  m_Name: Tuto_Dialogue2
  m_EditorClassIdentifier: Assembly-CSharp::EasternFantasy.Dialogue.DialogueSequence
  playerCharacter: {fileID: 11400000, guid: 2758d9b9772cd2441bb27040af28cb98, type: 2}
  partnerCharacter: {fileID: 0}
  lines:
  - speaker: 0
    text: "\uD5C8, \uB3C4\uAE68\uBE44\uB77C... \n\uB9C8\uC744 \uAC00\uAE4C\uC774\uC5D0
      \uC788\uB2E4\uB2C8 \uB4DC\uBB38 \uC77C\uC774\uAD6C\uB098"
    classOverrides:
    - characterClass: 1
      text: "\uB3C4\uAE68\uBE44\uC778\uAC00? \uB9C8\uC744 \uAC00\uAE4C\uC774\uC120
        \uCC98\uC74C \uBCF4\uB294\uAD70"
  - speaker: 0
    text: "\uC5B4\uB514 \uBCF4\uC790. \n\uC544\uC9C1\uB3C4 \uB3C4\uC220\uC744 \uC0AC\uC6A9\uD560
      \uC218 \uC788\uC73C\uB824\uB098?"
    classOverrides:
    - characterClass: 1
      text: "\uC9C0\uAE08\uAE4C\uC9C0\uC758 \uC218\uD589\uC758 \uACB0\uACFC\uB97C
        \uBCFC \uC218 \uC788\uACA0\uC5B4."
  - speaker: 0
    text: "Ctrl\uD0A4\uB85C \uAE30\uBCF8 \uACF5\uACA9\uC744 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    classOverrides:
    - characterClass: 1
      text: "Ctrl\uD0A4\uB85C \uAE30\uBCF8 \uACF5\uACA9\uC744 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
