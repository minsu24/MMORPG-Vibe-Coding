  playerCharacter: {fileID: 11400000, guid: 2758d9b9772cd2441bb27040af28cb98, type: 2}
  partnerCharacter: {fileID: 0}
  lines:
  - speaker: 0
    text: "\uC7A5\uC2E0\uAD6C\uB4E4\uC740 \uACE0\uC720\uD55C \uD2B9\uC218\uB2A5\uB825\uC744
      \uC9C0\uB2D9\uB2C8\uB2E4. \uAC8C\uC784\uC744 \uC9C4\uD589\uD558\uBA70 \uC5EC\uB7EC
      \uC7A5\uC2E0\uAD6C\uB97C \uBAA8\uC544\uBCF4\uC138\uC694."
    classOverrides: []
    firstAdvancementText: 
  - speaker: 0
    text: "I\uD0A4\uB85C \uC778\uBCA4\uD1A0\uB9AC\uC758 \uC7A5\uC2E0\uAD6C \uD0ED\uC744
      \uC5F4\uACE0, J\uD0A4\uB85C \uC7A5\uBE44\uCC3D\uC744 \uC5EC\uC138\uC694. \uB450\uAEBC\uBE44
      \uBC29\uC6B8 \uBAA9\uAC78\uC774\uB97C \uBAA9\uAC78\uC774 \uCE78\uC5D0 \uB4DC\uB798\uADF8\uD558\uBA74
      \uC810\uD504 \uB192\uC774\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
