MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec1556faa70b3ce43862d54865c7f42e, type: 3}
  m_Name: GoldFrogDialogue
  m_EditorClassIdentifier: Assembly-CSharp::EasternFantasy.Dialogue.DialogueSequence
  playerCharacter: {fileID: 11400000, guid: 2758d9b9772cd2441bb27040af28cb98, type: 2}
  partnerCharacter: {fileID: 11400000, guid: dd5dd9ecf476ebe48818042269cd8b60, type: 2}
  lines:
  - speaker: 0
    text: "\uB204\uAD6C\uB0D0!!"
  - speaker: 1
    text: "\uADF8 \uB140\uC11D\uC744 \uCC98\uCE58\uD558\uACE0 \uC624\uB2E4\uB2C8
      \uBC94\uC778\uC740 \uC544\uB2CC\uAC00 \uBCF4\uAD6C\uB098"
  - speaker: 1
    text: "\uB09C \uAE08\uB450\uAEBC\uBE44 \uC120\uC778\uC77C\uC138. \uADF8\uB0E5
      \uB450\uAEBC\uBE44 \uC5B4\uB974\uC2E0\uC774\uB77C\uACE0 \uBD80\uB974\uC2DC\uAC8C\uB098. "
  - speaker: 0
    text: "\uB450\uAEBC\uBE44 \uC5B4\uB974\uC2E0.. \uADF8\uB098\uC800\uB098 \uC774\uAC74?"
  - speaker: 1
    text: "\uC790\uB124\uB3C4 \uC655\uB450\uAEBC\uBE44\uB97C \uBCF4\uBA70 \uC9D0\uC791\uD588\uACA0\uC9C0\uB9CC
      \uBD09\uC778\uC774 \uAE68\uC838\uBC84\uB838\uB124."
  - speaker: 0
    text: "\uD5C8... \uADF8\uAC8C \uAE68\uC9C8 \uC218 \uC788\uB294 \uAC83\uC774 \uC5C6\uC2B5\uB2C8\uAE4C?"
  - speaker: 1
    text: "\uADF8\uB7EC\uAC8C \uB9D0\uC77C\uC138. \uC138\uC0C1\uC5D0 \uD63C\uB780\uC774
      \uC77C\uACA0\uAD6C\uB9CC.. \uC790\uB124\uB3C4 \uD798\uC744 \uCC3E\uC544\uC57C
      \uD560 \uAC83\uC774\uC57C."
