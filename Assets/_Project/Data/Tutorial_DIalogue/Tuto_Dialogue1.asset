  playerCharacter: {fileID: 11400000, guid: 2758d9b9772cd2441bb27040af28cb98, type: 2}
  partnerCharacter: {fileID: 0}
  lines:
  - speaker: 0
    text: "\uCC38\uC73C\uB85C \uC624\uB79C\uB9CC\uC5D0 \uC0B0\uC744 \uB0B4\uB824\uC624\uB294\uAD70.
      \uC774\uACF3\uB9CC \uC9C0\uB098\uBA74 \uB9C8\uC744\uC778\uAC00? "
    classOverrides:
    - characterClass: 1
      text: "\uC5B4\uB290\uC0C8 \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uAD6C\uB098. \n\uC774\uACF3\uB9CC
        \uC9C0\uB098\uBA74 \uB9C8\uC744\uC778\uAC00?"
  - speaker: 0
    text: "\uD5CC\uB370 \uC774 \uBD88\uAE38\uD55C \uAE30\uC6B4\uC740 \uBB34\uC5C7\uC774\uC9C0.."
    classOverrides: []
  - speaker: 0
    text: "\uC591\uCABD \uBC29\uD5A5\uD0A4\uB97C \uC774\uC6A9\uD574 \uC88C\uC6B0\uB85C
      \uC6C0\uC9C1\uC77C \uC218 \uC788\uACE0 \n\uC2A4\uD398\uC774\uC2A4 \uBC14\uB85C
      \uC810\uD504\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    classOverrides: []
