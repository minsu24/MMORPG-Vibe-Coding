  playerCharacter: {fileID: 11400000, guid: 2758d9b9772cd2441bb27040af28cb98, type: 2}
  partnerCharacter: {fileID: 11400000, guid: efd84278adad9d04a9339b42ae8779b0, type: 2}
  lines:
  - speaker: 1
    text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4. \uC694\uC998 \uB4E4\uC5B4 \uC694\uAD34\uC758
      \uCD9C\uBAB0\uC774 \uBD80\uCA4D \uC7A6\uC544\uC84C\uC2B5\uB2C8\uB2E4..."
  - speaker: 0
    text: "\uADF8\uB807\uAD70\uC694. \uC81C\uAC00 \uBB34\uC2A8\uC77C\uC778\uC9C0
      \uC54C\uC544\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: 1
    text: "\uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4. \uC774\uAC74 \uC81C\uAC00 \uC900\uBE44\uD55C
      \uC18C\uC815\uC758 \uB2F5\uB840\uC785\uB2C8\uB2E4."
