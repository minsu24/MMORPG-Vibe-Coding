MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec1556faa70b3ce43862d54865c7f42e, type: 3}
  m_Name: TutoNPC_DIalogue1
  m_EditorClassIdentifier: Assembly-CSharp::EasternFantasy.Dialogue.DialogueSequence
  playerCharacter: {fileID: 11400000, guid: 2758d9b9772cd2441bb27040af28cb98, type: 2}
  partnerCharacter: {fileID: 11400000, guid: efd84278adad9d04a9339b42ae8779b0, type: 2}
  lines:
  - speaker: 1
    text: "\uC624\uB79C\uB9CC\uC785\uB2C8\uB2E4. \uB3C4\uC0AC\uB2D8"
    classOverrides:
    - characterClass: 1
      text: "\uC774 \uB9C8\uC744\uAE4C\uC9C0 \uC5B4\uC5F0\uC77C\uB85C"
    - characterClass: 2
      text: "\uAC80\uC0AC\uB2D8\uC774\uC2E0\uAC00\uC694?"
  - speaker: 0
    text: "\uB124. \uC55E\uC5D0\uC11C \uB3C4\uAE68\uBE44\uB97C \uCC98\uCE58\uD588\uB294\uB370,
      \uD639\uC2DC \uB9C8\uC744\uC5D0 \uBB34\uC2A8\uC774\uC0C1\uD55C \uC77C \uC5C6\uC2B5\uB2C8\uAE4C?"
    classOverrides:
    - characterClass: 1
      text: "\uC5EC\uB7EC \uC0B0\uC744 \uCC3E\uC544\uB2E4\uB2C8\uBA70 \uC218\uC591\uC744
        \uD558\uB294 \uC911\uC785\uB2C8\uB2E4."
    - characterClass: 2
      text: "\uB124.. \uCD08\uC2EC\uC790 \uC785\uB2C8\uB2E4."
  - speaker: 1
    text: "\uCD5C\uADFC \uB4E4\uC5B4 \uB9C8\uC744 \uC8FC\uBCC0\uC5D0 \uC694\uAD34\uB4E4\uC774
      \uB298\uC5B4\uB0AC\uC2B5\uB2C8\uB2E4. "
    classOverrides:
    - characterClass: 1
      text: "\uADF8\uB807\uAD70\uC694. \uD639\uC2DC \uBD80\uD0C1\uD558\uB098\uB9CC
        \uB4DC\uB824\uB3C4 \uB418\uACA0\uC2B5\uB2C8\uAE4C? "
    - characterClass: 2
      text: "\uCD08\uC2EC\uC790 \uBD84\uAED8 \uC8C4\uC1A1\uD558\uC9C0\uB9CC \uD639\uC2DC
        \uBD80\uD0C1\uD558\uB098\uB9CC \n\uB4DC\uB824\uB3C4 \uB418\uACA0\uC2B5\uB2C8\uAE4C?"
  - speaker: 1
    text: "\uB9C8\uC744 \uC8FC\uBCC0\uC5D0\uC11C \uC720\uB839 5\uB9C8\uB9AC\uB97C
      \uCC98\uCE58\uD574\uC8FC\uC2E4 \uC218 \uC788\uC73C\uC2ED\uB2C8\uAE4C?"
    classOverrides: []
