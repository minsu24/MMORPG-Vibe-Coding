  lines:
  - speaker: 1
    text: "\uC624\uB79C\uB9CC\uC785\uB2C8\uB2E4. \uB3C4\uC0AC\uB2D8"
  - speaker: 0
    text: "\uB124. \uC55E\uC5D0\uC11C \uB3C4\uAE68\uBE44\uB97C \uCC98\uCE58\uD588\uB294\uB370,
      \uD639\uC2DC \uB9C8\uC744\uC5D0 \uBB34\uC2A8\uC774\uC0C1\uD55C \uC77C \uC5C6\uC2B5\uB2C8\uAE4C?"
  - speaker: 1
    text: "\uCD5C\uADFC \uB4E4\uC5B4 \uB9C8\uC744 \uC8FC\uBCC0\uC5D0 \uC694\uAD34\uB4E4\uC774
      \uB298\uC5B4\uB0AC\uC2B5\uB2C8\uB2E4. "
  - speaker: 1
    text: "\uB9C8\uC744 \uC8FC\uBCC0\uC5D0\uC11C \uC720\uB839 5\uB9C8\uB9AC\uB97C
      \uCC98\uCE58\uD574\uC8FC\uC2E4 \uC218 \uC788\uC73C\uC2ED\uB2C8\uAE4C?"
