  playerCharacter: {fileID: 11400000, guid: 2758d9b9772cd2441bb27040af28cb98, type: 2}
  partnerCharacter: {fileID: 0}
  lines:
  - speaker: 0
    text: "\uBD09\uC778\uB41C \uBAB8\uC73C\uB85C\uB294 \uC774 \uC815\uB3C4\uAC00
      \uCD5C\uB300\uC778\uAC00..."
  - speaker: 0
    text: "\uD5C8\uB098, \uC9C0\uAE08 \uC911\uC694\uD55C \uAC83\uC740 \uB0B4 \uD798\uC774
      \uC544\uB2C8\uC9C0."
  - speaker: 0
    text: "\uB3C4\uAEA0\uBE44\uAC00 \uC774\uACF3\uC5D0 \uC788\uB2E4\uB294 \uAC83\uC740..\n\uC5B4\uC11C
      \uB9C8\uC744\uB85C \uAC00\uBD10\uC57C\uACA0\uAD70."
