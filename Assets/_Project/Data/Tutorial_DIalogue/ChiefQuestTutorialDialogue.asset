  lines:
  - speaker: 0
    text: "\uBA38\uB9AC \uC704\uC5D0 \uB290\uB08C\uD45C \uD45C\uC2DC\uAC00 \uC788\uB294
      NPC\uC5D0\uAC8C \uB2E4\uAC00\uAC00 \nT\uD0A4\uB97C \uB204\uB974\uBA74 \uD018\uC2A4\uD2B8\uB97C
      \uC218\uB77D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    classOverrides: []
  - speaker: 0
    text: "\uD018\uC2A4\uD2B8 \uBAA9\uD45C\uB97C \uC9C4\uD589\uD55C \uB4A4 \uCD0C\uC7A5\uC5D0\uAC8C
      \uB3CC\uC544\uC640 T\uD0A4\uB97C \uB204\uB974\uBA74 \n\uC9C4\uD589 \uC0C1\uD669\uC744
      \uD655\uC778\uD558\uAC70\uB098 \uC644\uB8CC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    classOverrides: []
