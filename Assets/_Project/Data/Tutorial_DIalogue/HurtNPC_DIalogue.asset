  m_Script: {fileID: 11500000, guid: ec1556faa70b3ce43862d54865c7f42e, type: 3}
  m_Name: HurtNPC_DIalogue
  m_EditorClassIdentifier: Assembly-CSharp::EasternFantasy.Dialogue.DialogueSequence
  playerCharacter: {fileID: 11400000, guid: 2758d9b9772cd2441bb27040af28cb98, type: 2}
  partnerCharacter: {fileID: 11400000, guid: db9a8e346e2893b4b90324c792016227, type: 2}
  lines:
  - speaker: 1
    text: "\uC694\uAD34\uB97C \uC7A1\uC73C\uC2DC\uB294 \uBAA8\uC2B5\uC744 \uBCF4\uB2C8
      \uB3C4\uB825\uC774 \uB192\uC73C\uC2E0 \uBD84 \uAC19\uC2B5\uB2C8\uB2E4..."
  - speaker: 0
    text: "\uAD1C\uCC2E\uC73C\uC2ED\uB2C8\uAE4C? "
  - speaker: 1
    text: "\uC608... \uC55E\uC5D0 \uAC15\uB825\uD55C \uB450\uAEBC\uBE44\uAC00 \uC788\uB294\uB370
      \uC81C \uD798\uC73C\uB860 \uB3C4\uC800\uD788 \uC774\uAE38 \uC218\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC81C\uAC00 \uCC98\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4. "
  - speaker: 1
    text: "\uBD80\uB514 \uC870\uC2EC\uD558\uC2DC\uAE38..."
