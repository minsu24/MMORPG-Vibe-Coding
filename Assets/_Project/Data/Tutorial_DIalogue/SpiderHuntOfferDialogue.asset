  m_Script: {fileID: 11500000, guid: ec1556faa70b3ce43862d54865c7f42e, type: 3}
  m_Name: SpiderHuntOfferDialogue
  m_EditorClassIdentifier: Assembly-CSharp::EasternFantasy.Dialogue.DialogueSequence
  playerCharacter: {fileID: 11400000, guid: 2758d9b9772cd2441bb27040af28cb98, type: 2}
  partnerCharacter: {fileID: 11400000, guid: efd84278adad9d04a9339b42ae8779b0, type: 2}
  lines:
  - speaker: 1
    text: "\uC720\uB839\uB4E4\uC744 \uBB3C\uB9AC\uCCD0 \uC8FC\uC5B4 \uACE0\uB9D9\uB124.
      \uD558\uC9C0\uB9CC \uAC70\uBBF8\uB3D9\uAD74\uC5D0\uB3C4 \uC694\uAD34 \uAC70\uBBF8\uB4E4\uC774
      \uB4E4\uB053\uACE0 \uC788\uB2E4\uB124."
    classOverrides: []
  - speaker: 1
    text: "\uAC70\uBBF8\uB3D9\uAD74\uC5D0\uC11C \uAC70\uBBF8 10\uB9C8\uB9AC\uB97C
      \uCC98\uCE58\uD574 \uC8FC\uACA0\uB098? \uC77C\uC744 \uB9C8\uCE58\uBA74 \uB3D9\uAD74\uC5D0
      \uC788\uB294 \uB2E4\uCE5C \uC8FC\uBBFC\uC5D0\uAC8C \uAC00\uC11C \uC54C\uB824
      \uC8FC\uAC8C."
    classOverrides: []
  - speaker: 1
    text: "\uAC70\uBBF8\uB4E4\uC744 \uBAA8\uB450 \uCC98\uCE58\uD558\uAE30 \uC804\uC5D0\uB294
      \uB2AA\uC9C0\uB300\uB85C \uD5A5\uD558\uB294 \uAE38\uC744 \uC9C0\uB098\uAC08
      \uC218 \uC5C6\uC744 \uAC78\uC138."
    classOverrides: []
