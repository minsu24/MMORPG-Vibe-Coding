  lines:
  - speaker: 0
    text: "\uC0C1\uC810\uC8FC\uC778\uC5D0\uAC8C \uB2E4\uAC00\uAC00 T\uD0A4\uB97C
      \uB204\uB974\uBA74 \uC0C1\uC810\uC744 \uC774\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
