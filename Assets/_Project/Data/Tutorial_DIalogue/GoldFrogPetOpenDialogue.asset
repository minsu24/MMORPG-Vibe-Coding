--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec1556faa70b3ce43862d54865c7f42e, type: 3}
  m_Name: GoldFrogPetOpenDialogue
  m_EditorClassIdentifier: Assembly-CSharp::EasternFantasy.Dialogue.DialogueSequence
  playerCharacter: {fileID: 11400000, guid: 2758d9b9772cd2441bb27040af28cb98, type: 2}
  partnerCharacter: {fileID: 11400000, guid: dd5dd9ecf476ebe48818042269cd8b60, type: 2}
  lines:
  - speaker: 1
    text: "\uC7A0\uAE50 \uC790\uB124\uAC00 \uB4E4\uACE0 \uC788\uB294 \uADF8\uAC83
      \uB3C4\uAE68\uBE44\uC758 \uC601\uD63C\uC544\uB2CC\uAC00?"
    classOverrides: []
  - speaker: 0
    text: "\uADF8\uB807\uC2B5\uB2C8\uB2E4. \uB2F9\uCD5C \uC5B4\uB514\uB2E4 \uC4F0\uB294
      \uAC83\uC778\uC9C0.."
    classOverrides:
    - characterClass: 2
      text: "\uB124. \uADFC\uB370 \uC5B4\uB514\uC5D0 \uC4F0\uB294\uAC74\uAC00\uC694?"
  - speaker: 1
    text: "\uD558\uD558\uD558. \uC694\uAD34 \uB3D9\uD589\uC774\uB77C\uACE0 \uD574\uC57C
      \uD560\uAE4C"
    classOverrides: []
  - speaker: 0
    text: "\uADF8\uAC8C \uBB34\uC5C7\uC785\uB2C8\uAE4C?"
    classOverrides:
    - characterClass: 2
      text: "\uB3D9\uD589 \uC694\uAD34\uC694?"
  - speaker: 1
    text: "\uC694\uAD34\uB4E4\uACFC \uC2F8\uC6B0\uB2E4 \uBCF4\uBA74 \uD2B9\uC815
      \uC694\uAD34\uC758 \uC601\uD63C\uC744 \uC5BB\uC744 \uC218 \uC788\uB124.\n\uD574\uB2F9
      \uC694\uAD34\uAC00 \uC724\uD68C\uC758 \uACE0\uB9AC\uB85C \uB4E4\uC5B4\uAC00\uAE30
      \uC804\n\uC601\uD63C\uC744 \uC774\uC6A9\uD574 \uD604\uC138\uB85C \uB2E4\uC2DC
      \uBD88\uB7EC\uC624\uB294\uAC8C\uC57C."
    classOverrides: []
  - speaker: 1
    text: "\uADF8\uB807\uAC8C \uBD88\uB7EC\uC628 \uC694\uAD34\uC640 \uC77C\uC885\uC758
      \uACC4\uC57D\uC744 \uB9FA\uC5B4\n\uC790\uB124\uB97C \uB3C4\uC640\uC8FC\uB294
      \uAC83\uC77C\uC138. "
    classOverrides: []
  - speaker: 0
    text: "\uC544\uB2C8.. \uC694\uAD34\uB97C \uC5B4\uB5BB\uAC8C \uBBFF\uC2B5\uB2C8\uAE4C?"
    classOverrides:
    - characterClass: 2
      text: "\uC694\uAD34\uB791 \uACC4\uC57D\uC744\uC694? \uBB34\uC11C\uC6B4\uB370.."
  - speaker: 1
    text: "\uAC71\uC815\uB9D0\uAC8C\uB098. \uB098\uC05C \uC694\uAD34\uB9CC \uC874\uC7AC\uD558\uB294
      \uAC83\uC740 \uC544\uB2C8\uC57C.\n\uB098 \uB610\uD55C \uC694\uAD34\uC758 \uBAB8\uC73C\uB85C
      \uD0DC\uC5B4\uB098 \n\uC2E0\uC120\uC758 \uC790\uB9AC\uC5D0 \uB3C4\uB2EC\uD55C\uAC78\uC138."
    classOverrides: []
